{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "gridpbx/switch-client",
    "description": "Typed Switch Crossbar API client for GridPBX.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "GridPbx\\Switch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GridPbx\\Switch\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
