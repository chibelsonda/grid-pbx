APP_NAME=GridPBX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
FRONTEND_URL=http://localhost:5173
# Comma-separated explicit origins for non-local deployments.
FRONTEND_URLS=http://localhost:5173
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_THROTTLE_SECONDS=60
AUTH_FORGOT_PASSWORD_RATE_LIMIT=5
AUTH_RESET_PASSWORD_RATE_LIMIT=5

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gridpbx
DB_USERNAME=gridpbx
DB_PASSWORD=gridpbx-local-change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local Compose captures SMTP messages in Mailpit. Configure a real delivery
# mailer outside local development.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@gridpbx.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:*,127.0.0.1:*

GRID_ADMIN_EMAIL=admin@gridpbx.local
GRID_ADMIN_PASSWORD=admin-change-me

SWITCH_BASE_URL=http://switch:8000/v2
# Docker Compose supplies http://provisioner-catalog/api for local discovery.
# Override with a real provisioner API root outside local development.
SWITCH_PROVISIONER_URL=http://provisioner-catalog/api
SWITCH_PROVISIONER_AUTH_TYPE=none
SWITCH_PROVISIONER_TOKEN=
SWITCH_PROVISIONER_USERNAME=
SWITCH_PROVISIONER_PASSWORD=
SWITCH_PROVISIONER_HEADER_NAME=X-Auth-Token
SWITCH_PROVISIONER_TIMEOUT=10
SWITCH_PROVISIONER_VERIFY_TLS=true
SWITCH_API_KEY=
SWITCH_ACCOUNT_ID=
SWITCH_ACCOUNT_NAME=GridPBX
SWITCH_ACCOUNT_REALM=gridpbx.local
SWITCH_ACCOUNT_TIMEZONE=UTC
SWITCH_TIMEOUT=10
SWITCH_CDR_PAGE_SIZE=200
SWITCH_CDR_IMPORT_WINDOW_DAYS=7
DASHBOARD_CALL_GEOGRAPHY_ENABLED=false
DASHBOARD_CALL_GEOGRAPHY_SOURCE=unconfigured
DASHBOARD_CALL_GEOGRAPHY_MAXIMUM_LOCATIONS=100
SWITCH_RECORDING_PAGE_SIZE=200
SWITCH_RECORDING_IMPORT_WINDOW_DAYS=31
SWITCH_FAX_PAGE_SIZE=200
SWITCH_FAX_IMPORT_WINDOW_DAYS=31
# Disabled until the client approves a projection freshness target.
SWITCH_EXTENSION_POLLING_ENABLED=false
SWITCH_EXTENSION_POLL_INTERVAL_MINUTES=15
SWITCH_EXTENSION_POLL_BATCH_SIZE=10
SWITCH_LINE_KEY_MUTATIONS_ENABLED=false
SWITCH_CONFERENCE_PARTICIPANT_TOKEN_TTL=300
REDIS_QUEUE_RETRY_AFTER=150

PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=authorize_net
PAYMENT_MUTATIONS_ENABLED=false
AUTHORIZENET_ENVIRONMENT=sandbox
AUTHORIZENET_API_LOGIN_ID=
AUTHORIZENET_TRANSACTION_KEY=
AUTHORIZENET_PUBLIC_CLIENT_KEY=
AUTHORIZENET_SIGNATURE_KEY=
AUTHORIZENET_WEBHOOK_ENABLED=false
AUTHORIZENET_WEBHOOK_MAX_BODY_BYTES=65536
AUTHORIZENET_SANDBOX_CHARGE_ENABLED=false
AUTHORIZENET_SANDBOX_VOID_ENABLED=false
AUTHORIZENET_SANDBOX_REFUND_ENABLED=false
AUTHORIZENET_SANDBOX_PROFILE_ENABLED=false
AUTHORIZENET_SANDBOX_MAX_CHARGE_MINOR=100
AUTHORIZENET_SANDBOX_MAX_REFUND_MINOR=100

# Authoritative billing document adapters remain fail-closed until implemented and approved.
BILLING_INVOICE_PROVIDER=unconfigured
BILLING_RECEIPT_PROVIDER=unconfigured
BILLING_LEGACY_ENABLED=false
BILLING_LEGACY_AUTHORITY_CONFIRMED=false
BILLING_LEGACY_READ_ONLY_CONFIRMED=false
BILLING_DOCUMENT_MAXIMUM_BYTES=10485760
BILLING_LEGACY_DETAIL_LOOKUP_LIMIT=500
BILLING_LEGACY_DB_HOST=127.0.0.1
BILLING_LEGACY_DB_PORT=3306
BILLING_LEGACY_DB_DATABASE=
BILLING_LEGACY_DB_USERNAME=
BILLING_LEGACY_DB_PASSWORD=
BILLING_LEGACY_DB_SOCKET=
BILLING_LEGACY_DB_SSL_CA=
