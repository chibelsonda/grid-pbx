GRID_API_PORT=8081
GRID_UI_PORT=5173
GRID_UI_HTTPS_PORT=5443
GRID_PROVISIONER_CATALOG_PORT=8082
GRID_DNS_PRIMARY=1.1.1.1
GRID_DNS_SECONDARY=8.8.8.8
# Use one persistent key for the API and worker.
# Generate one with: cd grid-api && php artisan key:generate --show
GRID_API_APP_KEY=

GRID_DB_PORT=3309
GRID_DB_DATABASE=gridpbx
GRID_DB_USERNAME=gridpbx
GRID_DB_PASSWORD=gridpbx-local-change-me
GRID_DB_ROOT_PASSWORD=gridpbx-root-local-change-me

GRID_ADMIN_EMAIL=admin@gridpbx.local
GRID_ADMIN_PASSWORD=admin-change-me

SWITCH_BASE_URL=http://switch:8000/v2
# The Compose default is the local discovery-only catalog at
# http://provisioner-catalog/api. Override this with a real provisioner API root
# in production. GridPBX requests {SWITCH_PROVISIONER_URL}/phones.
SWITCH_PROVISIONER_URL=http://provisioner-catalog/api
# Client provisioners commonly use bearer, basic, or a token header. Keep secrets
# out of VITE_* variables so they are never bundled into the browser.
SWITCH_PROVISIONER_AUTH_TYPE=none
SWITCH_PROVISIONER_TOKEN=
SWITCH_PROVISIONER_USERNAME=
SWITCH_PROVISIONER_PASSWORD=
SWITCH_PROVISIONER_HEADER_NAME=X-Auth-Token
SWITCH_PROVISIONER_TIMEOUT=10
SWITCH_PROVISIONER_VERIFY_TLS=true
SWITCH_LINE_KEY_MUTATIONS_ENABLED=false
SWITCH_API_KEY=
SWITCH_ACCOUNT_ID=
SWITCH_ACCOUNT_NAME=GridPBX
SWITCH_ACCOUNT_REALM=gridpbx.local
SWITCH_CDR_PAGE_SIZE=200
SWITCH_CDR_IMPORT_WINDOW_DAYS=7
SWITCH_EXTENSION_POLLING_ENABLED=false
SWITCH_EXTENSION_POLL_INTERVAL_MINUTES=15
SWITCH_EXTENSION_POLL_BATCH_SIZE=10
REDIS_QUEUE_RETRY_AFTER=150
