:80 {
	encode zstd gzip

	route {
		@backend path /api/* /sanctum/* /storage/*
		reverse_proxy @backend grid-api:8081

		@session_mutation {
			path /login /logout /forgot-password /reset-password
			method POST OPTIONS
		}
		reverse_proxy @session_mutation grid-api:8081

		reverse_proxy grid-ui:80
	}
}
